PRODUCT_TO_MCP_ENV=production

# Use sqlite:/// locally, or a Render Postgres internal/external URL in Render.
# Keep the real value only in local ignored .env files or Render env vars.
PRODUCT_TO_MCP_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Must be the public HTTPS URL of the backend, not the frontend.
# Smithery will publish MCP endpoints generated under this base URL.
PRODUCT_TO_MCP_PUBLIC_BASE_URL=https://api.your-domain.com

# Comma-separated frontend origins allowed to call the backend.
PRODUCT_TO_MCP_CORS_ORIGINS=https://app.your-domain.com

# Comma-separated backend hostnames accepted by the API server.
# Use your backend hostname in production. Use * only for local/dev.
PRODUCT_TO_MCP_ALLOWED_HOSTS=api.your-domain.com

PRODUCT_TO_MCP_SMITHERY_API_URL=https://api.smithery.ai
PRODUCT_TO_MCP_MAX_OPENAPI_BYTES=20971520

# Optional protection for generated MCP endpoints.
# For the first Smithery URL-publish validation, leave this blank unless the
# Smithery publish integration is extended to pass compatible auth config.
# For real production, replace this with proper MCP OAuth/access control.
PRODUCT_TO_MCP_MCP_BEARER_TOKEN=replace-with-long-random-token

# Required if upstream API credentials should survive backend restarts.
# Generate a long random value and keep it stable for this deployment.
PRODUCT_TO_MCP_SECRET_ENCRYPTION_KEY=replace-with-long-random-secret
